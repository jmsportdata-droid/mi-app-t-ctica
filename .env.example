# Copiá este archivo a .env.local y completá los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo del lado del servidor: nunca la uses en componentes de cliente ni la expongas
# con el prefijo NEXT_PUBLIC_. Se usa para crear los usuarios del cuerpo técnico.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Solo del lado del servidor: importación de planteles y rivales desde API-Football
# (dashboard.api-football.com → Account → My Access). Plan gratuito: 100 consultas/día.
API_FOOTBALL_KEY=tu-api-football-key
